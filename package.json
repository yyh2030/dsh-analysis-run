{
  "name": "@local/analysis-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "分析直通：DDT 原始 CSV → 逐试次长表 → 无差异点/AUC/k → 三线表与报告，每次运行记下数据指纹与门禁结论",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "pipeline.py",
    "ddt.py",
    "sap.py",
    "client.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
