{
  "name": "@local/analysis-run",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local CSV analysis with explicit study plans, gated analysis modules and immutable run snapshots",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "engine.py",
    "office_export.py",
    "vendor/wheels",
    "vendor/install.mjs",
    "vendor/manifest.json",
    "vendor/README.md",
    "study-context.mjs",
    "study-selection.mjs",
    "client.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "tools"
  ],
  "dsh": {
    "minVersion": "0.2.2-rc.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
